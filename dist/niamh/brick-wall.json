{
  "name": "Brick wall",
  "description": "An albedo image and a tangent-space normal map on a wall, lit from above so the mortar joints catch the light; a glossy sphere wears the same normal map. Textures are loaded from the PNG files beside this file.",
  "conventions": {
    "coordinates": "Right-handed, +y up, camera looks down -z.",
    "color": "Linear RGB; the albedo image is sRGB and decoded on load, the normal map is stored linearly."
  },
  "film": { "width": 640, "height": 480 },
  "background": [0.02, 0.02, 0.03],
  "camera": {
    "position": [0.5, 1.3, 3.6],
    "target": [0, 1.2, 0],
    "verticalFovDegrees": 40
  },
  "textures": {
    "brick": { "type": "image", "file": "brick-albedo.png", "scale": 4, "filter": "trilinear" },
    "brickNormal": { "type": "image", "file": "brick-normal.png", "scale": 4, "srgb": false, "filter": "trilinear" },
    "sphereBrickNormal": { "type": "image", "file": "brick-normal.png", "scale": 2, "srgb": false, "filter": "trilinear" }
  },
  "materials": {
    "wall": { "type": "diffuse", "albedo": "brick", "normalMap": "brickNormal" },
    "floor": { "type": "diffuse", "albedo": [0.4, 0.4, 0.42] },
    "ball": { "type": "glossy", "albedo": [0.7, 0.7, 0.75], "roughness": 0.25, "normalMap": "sphereBrickNormal" },
    "light": { "type": "emissive", "radiance": [18, 16, 13] }
  },
  "shapes": [
    { "name": "wall", "type": "quad", "corner": [-1.8, 0, -1.2], "edgeU": [3.6, 0, 0], "edgeV": [0, 3.6, 0], "material": "wall" },
    { "name": "floor", "type": "quad", "corner": [-1.8, 0, -1.2], "edgeU": [0, 0, 5.2], "edgeV": [3.6, 0, 0], "material": "floor" },
    { "name": "light", "type": "quad", "corner": [-0.8, 2.6, -0.2], "edgeU": [1.6, 0, 0], "edgeV": [0, 0, 0.8], "material": "light" },
    { "name": "ball", "type": "sphere", "center": [0.8, 0.45, 0.7], "radius": 0.45, "material": "ball" }
  ]
}
